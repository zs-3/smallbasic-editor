<Project>
  <PropertyGroup>
    <NuGetAudit>false</NuGetAudit>
    <NuGetAuditLevel>none</NuGetAuditLevel>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NETSDK1138</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;NETSDK1138</NoWarn>
  </PropertyGroup>

  <Target Name="DisableNuGetAuditWarningsAsErrors" BeforeTargets="Restore;BeforeBuild;CoreCompile">
    <PropertyGroup>
      <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NETSDK1138</WarningsNotAsErrors>
      <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;NETSDK1138</NoWarn>
    </PropertyGroup>
  </Target>
</Project>
